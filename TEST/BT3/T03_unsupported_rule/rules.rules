# T03 - unsupported rules: 2 valid rules (sid 3001 and 3015) around rules that are outside the supported subset
alert tcp any any -> any 80 (msg:"T03 valid rule"; content:"GET"; sid:3001;)
alert tcp any any -> any 80 (msg:"T03 pcre"; content:"GET"; pcre:"/etc/passwd/i"; sid:3002;)
alert tcp any any -> any 80 (msg:"T03 byte_test"; content:"GET"; byte_test:2,>,5,0; sid:3003;)
alert tcp any any -> any 80 (msg:"T03 flowbits"; content:"GET"; flowbits:set,x; sid:3004;)
alert tcp any any -> any 80 (msg:"T03 threshold"; content:"GET"; threshold:type limit, track by_src, count 1, seconds 60; sid:3005;)
alert tcp any any -> any 80 (msg:"T03 http_uri"; content:"GET"; http_uri; sid:3006;)
alert tcp any any -> any 80 (msg:"T03 negated content"; content:!"x"; sid:3007;)
alert icmp any any -> any any (msg:"T03 icmp"; sid:3008;)
drop tcp any any -> any 80 (msg:"T03 drop"; content:"GET"; sid:3009;)
alert tcp $HOME_NET any -> any 80 (msg:"T03 variable"; content:"GET"; sid:3010;)
alert tcp [10.0.0.1,10.0.0.2] any -> any 80 (msg:"T03 address list"; content:"GET"; sid:3011;)
alert tcp !10.0.0.1 any -> any 80 (msg:"T03 negated address"; content:"GET"; sid:3012;)
alert tcp any any -> any [80,443] (msg:"T03 port list"; content:"GET"; sid:3013;)
alert tcp any any -> any 80 (msg:"T03 flow stateless"; flow:stateless; content:"GET"; sid:3014;)
alert tcp any any -> any 80 (msg:"T03 reference and metadata"; content:"HTTP"; reference:url,example.com/t03; metadata:service http; sid:3015;)
alert tcp any any -> any 80 (msg:"T03 flags with a mask"; flags:PA,12; content:"GET"; sid:3016;)
