# T06 - indexer: seven header-only rules, sid 6001-6007 (rule number n has sid 6000 + n)
alert tcp any any -> any 80 (msg:"T06 rule 1: tcp port 80"; sid:6001;)
alert tcp any any -> any 1:1024 (msg:"T06 rule 2: tcp ports 1-1024"; sid:6002;)
alert tcp any any -> any any (msg:"T06 rule 3: tcp any port"; sid:6003;)
alert udp any any -> any 53 (msg:"T06 rule 4: udp port 53"; sid:6004;)
alert ip any any -> any any (msg:"T06 rule 5: ip any"; sid:6005;)
alert udp any any -> any 5000:6000 (msg:"T06 rule 6: udp ports 5000-6000"; sid:6006;)
alert tcp any 443 <> any 8443 (msg:"T06 rule 7: tcp 443 both ways 8443"; sid:6007;)
